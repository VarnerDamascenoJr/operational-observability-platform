{
  "name": "operational-observability-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Control plane for an operational observability platform.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run test:unit && npm run test:e2e",
    "check": "npm run lint && npm run format && npm run test:all && npm run build",
    "validate:observability": "bash scripts/validate-observability.sh",
    "smoke:observability": "bash scripts/smoke-observability.sh"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/sensible": "^6.0.3",
    "fastify": "^5.3.2",
    "pg": "^8.23.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.1.2",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.3",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.1.2"
  }
}
